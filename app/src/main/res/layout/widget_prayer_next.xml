<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_container"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp"
    android:gravity="center_vertical">

    <!-- Top Header Bar: App Name & Location + Date -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_app_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_widget_crescent"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/widget_app_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="نداء • الأقصر"
            android:textColor="#E5B869"
            android:textSize="12sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/widget_date_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="نوفمبر"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:includeFontPadding="false" />

    </LinearLayout>

    <!-- Main Section: Prayer Name & Large Adhan Time -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Prayer Name Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_prayer_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الصلاة القادمة"
                android:textColor="#80B3A2"
                android:textSize="11sp"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/widget_prayer_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="صلاة المغرب"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

        </LinearLayout>

        <!-- Prayer Time Column -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/widget_prayer_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="17:15"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/widget_time_period"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="موعد الأذان"
                android:textColor="#80B3A2"
                android:textSize="10sp"
                android:includeFontPadding="false" />

        </LinearLayout>

    </LinearLayout>

    <!-- Row 1: Adhan Countdown Pill -->
    <LinearLayout
        android:id="@+id/widget_countdown_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_widget_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp">

        <TextView
            android:id="@+id/widget_countdown_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="متبقي للأذان:"
            android:textColor="#80B3A2"
            android:textSize="11sp"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/widget_remaining_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2 س 29 د"
            android:textColor="#38D9A9"
            android:textSize="12sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

    </LinearLayout>

    <!-- Row 2 (Normal State): Upcoming Iqama Time -->
    <LinearLayout
        android:id="@+id/widget_iqama_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:background="@drawable/bg_widget_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp">

        <TextView
            android:id="@+id/widget_iqama_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="موعد الإقامة:"
            android:textColor="#80B3A2"
            android:textSize="11sp"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/widget_iqama_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="17:20 (5 دقائق)"
            android:textColor="#E5B869"
            android:textSize="11sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

    </LinearLayout>

    <!-- Row 2 (Active State): Countdown to Iqama right after Adhan -->
    <LinearLayout
        android:id="@+id/widget_iqama_active_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:background="@drawable/bg_widget_iqama_active"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_iqama_active_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⏳ باقي على الإقامة:"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/widget_iqama_active_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12:45 د"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

    </LinearLayout>

</LinearLayout>
