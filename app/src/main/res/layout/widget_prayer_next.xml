<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_container"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:layoutDirection="rtl"
    android:textDirection="rtl"
    android:gravity="center_vertical">

    <!-- Top Header Bar: App Icon & Name (Right) | Date (Left) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="rtl">

        <!-- Date on the far LEFT -->
        <TextView
            android:id="@+id/widget_date_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:gravity="left|center_vertical"
            android:text="نوفمبر"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:singleLine="true"
            android:includeFontPadding="false" />

        <!-- Crescent Icon on the far RIGHT -->
        <ImageView
            android:id="@+id/widget_app_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_widget_crescent"
            android:contentDescription="@null" />

        <!-- App Name: To the left of crescent icon, to the right of date -->
        <TextView
            android:id="@+id/widget_app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@id/widget_app_icon"
            android:layout_toRightOf="@id/widget_date_chip"
            android:layout_centerVertical="true"
            android:layout_marginRight="6dp"
            android:layout_marginLeft="6dp"
            android:gravity="right|center_vertical"
            android:text="نداء • الأقصر"
            android:textColor="#E5B869"
            android:textSize="11sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:includeFontPadding="false" />

    </RelativeLayout>

    <!-- Subtitle: "الصلاة القادمة" / "صلاة الغد" / "🕌 جارية الآن" (Right Aligned) -->
    <TextView
        android:id="@+id/widget_prayer_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="right|center_vertical"
        android:text="الصلاة القادمة"
        android:textColor="#80B3A2"
        android:textSize="11sp"
        android:singleLine="true"
        android:ellipsize="end"
        android:includeFontPadding="false" />

    <!-- Main Prayer Row: Time on Left, Prayer Name on Right -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:layoutDirection="rtl">

        <!-- Prayer Time on the far LEFT -->
        <TextView
            android:id="@+id/widget_prayer_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:gravity="left|center_vertical"
            android:text="18:30"
            android:textColor="#FFFFFF"
            android:textSize="25sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:includeFontPadding="false" />

        <!-- Prayer Name on the far RIGHT -->
        <TextView
            android:id="@+id/widget_prayer_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_toRightOf="@+id/widget_prayer_time"
            android:layout_centerVertical="true"
            android:layout_marginLeft="8dp"
            android:gravity="right|center_vertical"
            android:text="العشاء"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:includeFontPadding="false" />

    </RelativeLayout>

    <!-- Row 1: Adhan Countdown Pill (Time on Left, Title on Right) -->
    <RelativeLayout
        android:id="@+id/widget_countdown_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_widget_pill"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:layoutDirection="rtl">

        <!-- Countdown Value on the LEFT -->
        <TextView
            android:id="@+id/widget_remaining_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:gravity="left|center_vertical"
            android:text="2 س 29 د"
            android:textColor="#38D9A9"
            android:textSize="12sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:includeFontPadding="false" />

        <!-- Countdown Title on the RIGHT -->
        <TextView
            android:id="@+id/widget_countdown_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_toRightOf="@+id/widget_remaining_time"
            android:layout_centerVertical="true"
            android:layout_marginLeft="6dp"
            android:gravity="right|center_vertical"
            android:text="باقي للأذان:"
            android:textColor="#80B3A2"
            android:textSize="11sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:includeFontPadding="false" />

    </RelativeLayout>

    <!-- Row 2 (Normal State): Upcoming Iqama Time (Time on Left, Title on Right) -->
    <RelativeLayout
        android:id="@+id/widget_iqama_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_widget_pill"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:layoutDirection="rtl">

        <!-- Iqama Time on the LEFT -->
        <TextView
            android:id="@+id/widget_iqama_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:gravity="left|center_vertical"
            android:text="17:20 (5 د)"
            android:textColor="#E5B869"
            android:textSize="11sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:includeFontPadding="false" />

        <!-- Iqama Title on the RIGHT -->
        <TextView
            android:id="@+id/widget_iqama_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_toRightOf="@+id/widget_iqama_time"
            android:layout_centerVertical="true"
            android:layout_marginLeft="6dp"
            android:gravity="right|center_vertical"
            android:text="موعد الإقامة:"
            android:textColor="#80B3A2"
            android:textSize="11sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:includeFontPadding="false" />

    </RelativeLayout>

    <!-- Row 2 (Active State): Countdown to Iqama right after Adhan (Time on Left, Title on Right) -->
    <RelativeLayout
        android:id="@+id/widget_iqama_active_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_widget_iqama_active"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:layoutDirection="rtl"
        android:visibility="gone">

        <!-- Active Iqama Time on the LEFT -->
        <TextView
            android:id="@+id/widget_iqama_active_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:gravity="left|center_vertical"
            android:text="12:45 د"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:includeFontPadding="false" />

        <!-- Active Iqama Title on the RIGHT -->
        <TextView
            android:id="@+id/widget_iqama_active_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_toRightOf="@+id/widget_iqama_active_time"
            android:layout_centerVertical="true"
            android:layout_marginLeft="6dp"
            android:gravity="right|center_vertical"
            android:text="⏳ باقي للإقامة:"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:includeFontPadding="false" />

    </RelativeLayout>

</LinearLayout>
